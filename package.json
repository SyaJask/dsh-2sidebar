{
  "name": "dsh-2sidebar",
  "version": "0.1.3",
  "description": "Split-pane file browser for the DSH right sidebar: directory tree on the left, file content on the right.",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "scripts": {
    "check": "node --check client.js",
    "test": "node --test test/client.test.mjs test/manifest.test.mjs"
  },
  "author": "SyaJask",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SyaJask/dsh-2sidebar.git"
  },
  "homepage": "https://github.com/SyaJask/dsh-2sidebar#readme",
  "bugs": {
    "url": "https://github.com/SyaJask/dsh-2sidebar/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "file-browser",
    "sidebar",
    "split-view",
    "file-preview",
    "workspace"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-api-workspace-files",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}
