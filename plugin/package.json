{
  "name": "dsh-2sidebar",
  "version": "0.1.1",
  "description": "Split-pane file browser for the DSH right sidebar: directory tree on the left, file content on the right.",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "author": "SyaJask",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SyaJask/dsh-2sidebar.git",
    "directory": "plugin"
  },
  "homepage": "https://github.com/SyaJask/dsh-2sidebar#readme",
  "bugs": {
    "url": "https://github.com/SyaJask/dsh-2sidebar/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "file-browser",
    "sidebar",
    "split-view",
    "file-preview",
    "workspace"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-modules"
      ]
    }
  }
}
